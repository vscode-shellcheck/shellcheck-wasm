{
  "name": "@vscode-shellcheck/shellcheck-wasm",
  "version": "0.0.0-semantic-release",
  "description": "ShellCheck compiled to WebAssembly (WASI command module) with a Worker-based runner",
  "license": "GPL-3.0-or-later AND MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vscode-shellcheck/shellcheck-wasm.git"
  },
  "files": [
    "dist",
    "!dist/build-info.json",
    "!dist/browser-worker.*",
    "README.md",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./client": {
      "types": "./dist/client-entry.d.ts",
      "default": "./dist/client-entry.js"
    },
    "./browser/worker.js": "./dist/browser/worker.js",
    "./shellcheck.wasm": "./dist/shellcheck.wasm",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.ts && tsc -p tsconfig.build.json",
    "build:wasm": "scripts/build-wasm.sh",
    "fetch:native": "scripts/fetch-native-shellcheck.sh",
    "bench": "node scripts/bench.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "prepack": "node -e \"require('node:fs').accessSync('dist/shellcheck.wasm')\""
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.27.7",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
